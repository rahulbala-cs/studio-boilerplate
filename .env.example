# Copy to .env and fill in the stack API key, then run: npm run provision
# Everything else is written back by scripts/01-provision-stack.mjs.

# ── You provide this one ──────────────────────────────────────────────────────
NEXT_PUBLIC_CONTENTSTACK_API_KEY=blt00000000000000

# ── Optional overrides (defaults shown) ───────────────────────────────────────
NEXT_PUBLIC_CONTENTSTACK_ENVIRONMENT=preview
# URL prefix : stack locale code, comma separated. The FIRST entry is the default
# (unprefixed URLs redirect to it) and must be the stack's master locale.
# Add a language:  NEXT_PUBLIC_CONTENTSTACK_LOCALES=en:en-us,fr:fr-fr
NEXT_PUBLIC_CONTENTSTACK_LOCALES=en:en-us
# Studio iframes the canvas from an HTTPS origin, so this must be https.
NEXT_PUBLIC_BASE_URL=https://localhost:3000
# Both region settings must point at the data centre your stack lives in.
# The provisioning scripts: NA (default) or EU.
CONTENTSTACK_REGION=NA
# The app: us (default), eu, azure-na, azure-eu, gcp-na, gcp-eu, au.
NEXT_PUBLIC_CONTENTSTACK_REGION=us
NEXT_PUBLIC_CONTENTSTACK_STUDIO_CONTENT_TYPE=compositions

# ── Written by the provisioning scripts — do not edit by hand ─────────────────
# NEXT_PUBLIC_CONTENTSTACK_DELIVERY_TOKEN=
# NEXT_PUBLIC_CONTENTSTACK_PREVIEW_TOKEN=   (never set this on the public production site)
# CONTENTSTACK_ENVIRONMENT_UID=
# STUDIO_PROJECT_UID=

# Authentication is OAuth, resolved from the Contentstack MCP's stored session.
# Authenticate once with:  CONTENTSTACK_REGION=NA npx @contentstack/mcp --auth
# In CI, export CS_OAUTH_ACCESS_TOKEN and CS_ORG_UID instead.
