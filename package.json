{
  "name": "studio-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "A small, production-quality Contentstack Studio reference implementation.",
  "scripts": {
    "dev": "next dev --turbo --experimental-https -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "provision": "node scripts/provision.mjs",
    "provision:stack": "node scripts/01-provision-stack.mjs",
    "provision:content": "node scripts/03-seed-content.mjs",
    "provision:studio": "node scripts/02-provision-studio.mjs",
    "provision:sections": "node scripts/04-author-sections.mjs",
    "provision:templates": "node scripts/05-author-templates.mjs",
    "verify": "node scripts/06-verify.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"scripts/**/*.mjs\" middleware.ts next.config.mjs"
  },
  "dependencies": {
    "@contentstack/delivery-sdk": "5.6.0",
    "@contentstack/live-preview-utils": "4.5.2",
    "@contentstack/studio-client": "3.2.0",
    "@contentstack/studio-core": "1.4.2",
    "@contentstack/studio-react": "1.9.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prettier": "^3.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
